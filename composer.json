{
    "name": "dmytruk/wp-jobs-bot",
    "description": "Daily Telegram digest of new WordPress developer vacancies from job board RSS feeds.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "JobsBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JobsBot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": "php bin/run.php --dry-run"
    },
    "config": {
        "sort-packages": true
    }
}
